# Supabase backend storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public app URL used in emails
PUBLIC_APP_URL=https://airbnb-property-issue-management.onrender.com

# Optional: first approved admin bootstrap. Add your Google account email here before first registration.
# If no users are approved yet, this email will be auto-approved when it registers.
BOOTSTRAP_ADMIN_EMAILS=your-email@gmail.com

# Email via Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Propietarios Airbnb KAI <onboarding@resend.dev>

# Render
PORT=10000

# v22 admin/SLA settings
GLOBAL_ADMIN_EMAILS=youradmin@gmail.com
DEFAULT_SLA_HOURS=24
DEFAULT_ESCALATION_CC_EMAILS=
SLA_CHECK_INTERVAL_MS=900000
